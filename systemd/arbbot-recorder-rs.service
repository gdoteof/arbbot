# Rust recorder SHADOW unit (P1). Runs beside arbbot-recorder.service with
# isolated outputs (data/raw-rs, arbbot-rs.sock, health-rs.jsonl).
#
# SAFETY MODES:
#   Kalshi: full WS with its OWN read-only key (kalshi_recorder_rs_*, provisioned 2026-07-23). PM-US: --pmus-poll-only public REST — cannot contend with the live
#     Python recorder's WS key sessions. Low rate via --pmus-poll-interval.
#   Full WS shadow: REMOVE --poll-only only after the key-session question is
#     resolved (board card): needs either a second read-only Kalshi key
#     provisioned for the shadow, or confirmation that concurrent WS sessions
#     per key don't evict each other. The PM-US WS uses the trade-capable key
#     the LIVE recorder holds — never open a second session on it without
#     that confirmation.
#
# 2026-07-27: FULL WS on all three venues, each on its own key.
#   Kalshi  -> kalshi_recorder_rs_*   (read-only tier)
#   PM-US   -> polymarket_usa_rs_*    (Geoff provisioned; PM-US has no
#              read-only tier, so it is trade-capable — acceptable only
#              because this binary has NO order code path: it references no
#              order route and can reach only market-data hosts + ntfy)
# The separate PM-US key is the point: sharing the live recorder's key meant a
# second WS session on it, which is the contention the note below warns about.
# If the LIVE recorder's PM-US feed degrades after this, revert to
# --pmus-poll-only --pmus-poll-interval 8 immediately.
#
# Install (manual, deployment-time):
#   cp systemd/arbbot-recorder-rs.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user start arbbot-recorder-rs

[Unit]
Description=arbbot Rust recorder (shadow)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/claude/arbbot
# rs-suffixed READ-ONLY key only; the trade-capable keys are never loaded
# (--pmus-poll-only) even though the dir contains them
Environment=ARBBOT_CREDENTIALS_DIR=%h/.arbbot-credentials
ExecStart=%h/claude/arbbot/rust/target/release/arb-recorder \
    --config config/recorder.yaml \
    --data-dir data/raw-rs \
    --socket data/arbbot-rs.sock \
    --health data/health-rs.jsonl \
    --shadow --kalshi-cred-suffix rs \
    --pmus-cred-suffix rs
Restart=always
RestartSec=5
# shadow must never starve the real stack
Nice=10
MemoryMax=2G

[Install]
WantedBy=default.target
