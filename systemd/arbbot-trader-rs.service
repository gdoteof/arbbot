# Rust dry-run engine: what WOULD be traded if trading were enabled.
#
# Runs the real quoter against the LIVE recorder feed and appends its order
# intents to data/trader-rs/intents.jsonl, which the dashboard's /intents view
# reconstructs into "orders that would be resting right now".
#
# SAFETY: the order path is OFF. The binary now LINKS the venue gateways
# (arb-venue) so its executor seam carries real orders, but an executor with no
# sink counts its command and drops it, and a sink is only ever built by
# --enable-orders, which is absent here. --enable-orders additionally REFUSES
# to start while its preconditions are unmet (unseeded exposure, no live fill
# feed), so arming it is not a one-flag mistake.
#
# It honors data/KILL exactly like the Python trader (kill => cancel-all intents
# + quoting pause), pulls ALL quotes when a critical feed goes stale, and
# hard-gates quoting on the tradable registry.
#
# --balance is what the risk gate spends: a venue omitted here reads as $0 cash
# and every order on it is refused. Update when the real balances move.
#
# These are HAND-ENTERED and go stale silently — on 2026-07-28 the PM-US figure
# was $20.12 low, so the gate had been under-sizing that venue. Both venues DO
# expose live cash (`arb-order --venue <v> --preflight-only` is a signed read:
# Kalshi balance_dollars, PM-US buying_power), so an armed run should read them
# at startup instead of trusting this line. The shadow can't — it holds no
# credentials, which is why the flag exists at all.
#
# It subscribes to data/arbbot.sock, which since 2026-07-31 is served by
# `arb-recorder` — the Python recorder is retired. The socket path did not
# change, which is why this unit did not either.
#
# The recorder fans out to any number of subscribers and drops slow ones, so
# adding this costs the live stack nothing.
#
# --marks-out writes data/exec/marks-rs.json, the SHADOW of the file
# arbbot-marks.timer writes at data/exec/marks.json every 2 minutes. It is here
# and not on the armed engine deliberately: marks is a pure read of the ledger
# plus the book, so a shadow producing it costs nothing and proves parity
# against the writer being retired without putting the armed engine's re-mark
# loop on trial at the same time. Retiring arbbot-marks.timer means moving this
# flag to the armed unit and pointing it at data/exec/marks.json.

[Unit]
Description=arbbot Rust dry-run engine (intents only, no order path)
After=arbbot-recorder.service
Wants=arbbot-recorder.service

[Service]
Type=simple
WorkingDirectory=%h/claude/arbbot
ExecStart=%h/claude/arbbot/rust/target/release/arb-trader \
    --socket data/arbbot.sock \
    --registry config/registry.yaml \
    --tradable config/tradable.yaml \
    --health data/health.jsonl \
    --balance kalshi=340.09 \
    --balance polymarket_us=349.42 \
    --out data/trader-rs/intents.jsonl \
    --marks-out data/exec/marks-rs.json \
    --stats-every 300
Restart=always
RestartSec=5
# must never starve the live stack
Nice=10
MemoryMax=1G

[Install]
WantedBy=default.target
