# /home/geoff/.config/systemd/user/arbbot-dash-rs.service
# Rust instrument panel (arb-dash) on 127.0.0.1:4749.
#
# This is the first Rust component to own a production surface. It is
# READ-ONLY: it serves views over the tape, the scan output, the double-entry
# books and the dry-run engine's intents. It holds no credentials and has no
# order code path.
#
# Views: /current /opportunities /pairs /pair/<id> /intents /recording
#        plus SSE at /api/stream.
#
# PATHS — everything below must be durable. This unit exists because the dash
# was previously hand-launched with --kalshi-dir/--rollup-dir pointing into a
# coding-session scratchpad under /tmp, which disappears with the session.
#   data/venue/  venue-truth snapshots (kalshi_{deposits,fills,settlements}.json,
#                pmus_{balances,positions}.json). NOT generated by anything in
#                this repo yet — they are fetched by hand. The books views are
#                only as fresh as these files; a missing one is a hard error by
#                design (an empty book must never read as a reconciled book).
#   data/tob/    top-of-book rollups (arb-tob). The dash writes here via its
#                on-demand rollup trigger, so this must stay writable.
#
# --kalshi-balance / --pmus-deposits are fixed at startup and are venue truth
# as of the last snapshot. Update them here when the real balances move.
#
# Install (manual, deployment-time):
#   cp systemd/arbbot-dash-rs.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now arbbot-dash-rs

[Unit]
Description=arbbot Rust instrument panel (arb-dash, 127.0.0.1:4749)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/claude/arbbot
ExecStart=%h/claude/arbbot/rust/target/release/arb-dash \
    --port 4749 \
    --data-dir data \
    --scan-dir data/scan \
    --raw-dir data/raw \
    --parquet-dir data/parquet \
    --rollup-dir data/tob \
    --kalshi-dir data/venue \
    --pmus-dir data/venue \
    --kalshi-balance 340.0896 \
    --pmus-deposits 525.00 \
    --intents data/trader-rs/intents.jsonl \
    --registry config/registry.yaml \
    --tradable config/tradable.yaml
Restart=always
RestartSec=5
MemoryMax=2G

[Install]
WantedBy=default.target
