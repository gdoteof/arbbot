# Daily P1 shadow-gate report: compares yesterday's Rust shadow tape against
# the Python recorder's tape. Output: data/reports/shadow-gate-<day>.txt
[Unit]
Description=arbbot Rust-recorder shadow gate (daily comparison)

[Service]
Type=oneshot
WorkingDirectory=%h/claude/arbbot
Environment=PYTHONPATH=%h/claude/arbbot/.claude/worktrees/rust-rewrite/src
ExecStart=/bin/bash -c 'day=$(date -u -d yesterday +%%Y-%%m-%%d); mkdir -p data/reports; .venv/bin/python .claude/worktrees/rust-rewrite/scripts/shadow_gate.py --day $day --py-dir data/raw --rs-dir data/raw-rs > data/reports/shadow-gate-$day.txt 2>&1; tail -3 data/reports/shadow-gate-$day.txt'
